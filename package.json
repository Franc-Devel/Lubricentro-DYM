{
  "name": "lubricentro-dym",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema Integral de Gestión y Terminal POS para Lubricentro DYM - React + Node.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "prestart": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "repomix:local": "npx repomix -o CONTEXTO_CODIGO_BASE.local --style markdown --ignore \"bunker_local.db,*.db,*.sqlite,package-lock.json\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
